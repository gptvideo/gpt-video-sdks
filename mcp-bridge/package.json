{
  "name": "gpt-video-mcp",
  "version": "1.0.0",
  "description": "Connect GPT-Video to any AI assistant that speaks MCP over stdio. Edit video from Zed, JetBrains, Windsurf, n8n or behind a corporate proxy.",
  "license": "MIT",
  "homepage": "https://www.gpt-video.com/developers/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gptvideo/gpt-video-sdks.git",
    "directory": "mcp-bridge"
  },
  "bugs": {
    "url": "https://github.com/gptvideo/gpt-video-sdks/issues"
  },
  "author": {
    "name": "GPT-Video",
    "email": "hello@gpt-video.com"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "video",
    "video-editing",
    "clips",
    "captions",
    "gpt-video"
  ],
  "mcpName": "com.gpt-video/gpt-video-full",
  "type": "module",
  "bin": {
    "gpt-video-mcp": "./bin/gpt-video-mcp.mjs"
  },
  "exports": {
    ".": "./src/bridge.mjs"
  },
  "files": [
    "bin",
    "src/bridge.mjs",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
